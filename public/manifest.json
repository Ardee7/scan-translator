{
  "manifest_version": 3,
  "name": "Scan Translator",
  "description": "Select a visible comic region and translate its dialogue into English.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "action": {
    "default_title": "Open Scan Translator"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.openai.com"
  },
  "commands": {
    "select-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+S"
      },
      "description": "Snip a comic area to translate"
    },
    "toggle-click-mode": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Toggle click-to-translate mode"
    },
    "scan-viewport": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+D"
      },
      "description": "Translate visible screen"
    }
  }
}
